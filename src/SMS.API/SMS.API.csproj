<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SMS.API</RootNamespace>
    <AssemblyName>SMS.API</AssemblyName>
    <UserSecretsId>ef814193-d15a-421f-9b63-126d80981fce</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.13" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    wwwroot\uploads is runtime data (attachments, profile pictures, invoices, supplier documents), not project content.
    Left in the project, every upload added a file to it: Visual Studio's Hot Reload saw a project change it could not
    apply and stopped, rebuilt and restarted the API mid-request ("uploading a file stops the API"). Excluded here, the
    files are still written to and served from wwwroot\uploads exactly as before; the project just no longer sees them.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\uploads\**" />
    <None Remove="wwwroot\uploads\**" />
    <Compile Remove="wwwroot\uploads\**" />
    <EmbeddedResource Remove="wwwroot\uploads\**" />
    <Watch Remove="wwwroot\uploads\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMS.Shared\SMS.Shared.csproj" />
    <ProjectReference Include="..\SMS.Modules.Auth\SMS.Modules.Auth.csproj" />
    <ProjectReference Include="..\SMS.Modules.Tenancy\SMS.Modules.Tenancy.csproj" />
    <ProjectReference Include="..\SMS.Modules.Lookups\SMS.Modules.Lookups.csproj" />
    <ProjectReference Include="..\SMS.Modules.Suppliers\SMS.Modules.Suppliers.csproj" />
    <ProjectReference Include="..\SMS.Modules.Inventory\SMS.Modules.Inventory.csproj" />
    <ProjectReference Include="..\SMS.Modules.Demand\SMS.Modules.Demand.csproj" />
    <ProjectReference Include="..\SMS.Modules.Procurement\SMS.Modules.Procurement.csproj" />
    <ProjectReference Include="..\SMS.Modules.Warehouse\SMS.Modules.Warehouse.csproj" />
    <ProjectReference Include="..\SMS.Modules.Logistics\SMS.Modules.Logistics.csproj" />
    <ProjectReference Include="..\SMS.Modules.Finance\SMS.Modules.Finance.csproj" />
    <ProjectReference Include="..\SMS.Modules.Reports\SMS.Modules.Reports.csproj" />
    <ProjectReference Include="..\SMS.Modules.Notifications\SMS.Modules.Notifications.csproj" />
    <ProjectReference Include="..\SMS.WorkflowEngine\SMS.WorkflowEngine.csproj" />
    <ProjectReference Include="..\SMS.Modules.Material\SMS.Modules.Material.csproj" />
    <ProjectReference Include="..\SMS.Modules.Integration\SMS.Modules.Integration.csproj" />
  </ItemGroup>

</Project>
