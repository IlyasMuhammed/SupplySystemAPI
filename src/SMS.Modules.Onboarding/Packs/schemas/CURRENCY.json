{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sms://onboarding/schemas/CURRENCY.json",
  "title": "CURRENCY",
  "description": "Currencies to activate (Finance org_currencies). base is set as the sale/purchase/service base only while the org has no documents (D-14). Nothing is deactivated.",
  "type": "object",
  "properties": {
    "base": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false
    },
    "additional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "required": [
    "base",
    "additional"
  ],
  "additionalProperties": false
}
