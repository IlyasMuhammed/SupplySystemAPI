{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sms://onboarding/schemas/WAREHOUSE.json",
  "title": "WAREHOUSE",
  "description": "Zone types for warehouses (Inventory Zones, D-21). Warehouses themselves come from wizard input {warehouses:[{code,name,address?,city?,country?,zones?:[zoneType codes]}]}; with no input, defaultWarehouse is seeded with the zone types marked default (all when none marked).",
  "type": "object",
  "properties": {
    "zoneTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "defaultWarehouse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "required": [
    "zoneTypes"
  ],
  "additionalProperties": false
}
