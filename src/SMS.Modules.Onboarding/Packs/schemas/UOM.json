{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sms://onboarding/schemas/UOM.json",
  "title": "UOM",
  "description": "Units of measure (Lookups LookupValue type \"uom\", natural key = code). conversionFactor = how many base units one unit is; stored only, not applied (R-1).",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "isBase": {
                  "type": "boolean"
                },
                "conversionFactor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "code",
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "units"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "required": [
    "groups"
  ],
  "additionalProperties": false
}
