{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sms://onboarding/schemas/PRODUCT_CATEGORIES.json",
  "title": "PRODUCT_CATEGORIES",
  "description": "Inventory ProductCategory (level 1) and ProductSubCategory (children). Deeper levels are flattened into level 2 (R-2). Natural key = code.",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      },
      "minItems": 1
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "required": [
    "categories"
  ],
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      },
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
