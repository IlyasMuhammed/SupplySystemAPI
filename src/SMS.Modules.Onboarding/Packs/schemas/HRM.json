{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sms://onboarding/schemas/HRM.json",
  "title": "HRM",
  "description": "HR defaults (SMS.Modules.Hrm, natural keys: leave type code, salary component code, tax table code; D-30/D-90). UNVERIFIED: the payload must say verified:false and the seeder never marks a tax table verified.",
  "type": "object",
  "properties": {
    "verified": { "const": false },
    "verificationNote": { "type": ["string", "null"], "maxLength": 600 },
    "leaveTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[A-Z0-9][A-Z0-9_\\-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "entitlementDays": { "type": "number", "minimum": 0, "maximum": 366 },
          "isPaid": { "type": "boolean" },
          "carryForwardCap": { "type": ["number", "null"], "minimum": 0 },
          "attachmentAfterDays": { "type": ["integer", "null"], "minimum": 0 },
          "genderRestriction": { "enum": ["M", "F", "Other", null] },
          "accrualMethod": { "enum": ["Annual", "Monthly", "None"] },
          "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "required": ["code", "name", "entitlementDays", "isPaid"],
        "additionalProperties": false
      }
    },
    "salaryComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[A-Z0-9][A-Z0-9_\\-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "enum": ["Earning", "Deduction", "EmployerContribution", "Result"] },
          "isTaxable": { "type": "boolean" },
          "inGross": { "type": "boolean" },
          "calcMethod": { "enum": ["Fixed", "Percent", "Formula"] },
          "postingRole": { "type": ["string", "null"], "maxLength": 50, "pattern": "^[A-Z][A-Z0-9_]*$" },
          "expenseRole": { "type": ["string", "null"], "maxLength": 50, "pattern": "^[A-Z][A-Z0-9_]*$" },
          "formula": { "type": ["string", "null"], "maxLength": 1000 },
          "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
        },
        "required": ["code", "name", "type"],
        "additionalProperties": false
      }
    },
    "taxSlabTables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "countryCode": { "type": "string", "minLength": 2, "maxLength": 3 },
          "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "effectiveTo": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sourceNote": { "type": ["string", "null"], "maxLength": 500 },
          "slabs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": "number", "minimum": 0 },
                "to": { "type": ["number", "null"], "minimum": 0 },
                "fixedAmount": { "type": "number", "minimum": 0 },
                "ratePercent": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "required": ["from", "fixedAmount", "ratePercent"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["code", "name", "effectiveFrom", "slabs"],
        "additionalProperties": false
      }
    },
    "displayName": { "type": ["string", "null"], "maxLength": 200 },
    "notes": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "required": ["verified"],
  "additionalProperties": false
}
